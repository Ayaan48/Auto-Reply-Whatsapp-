# Only needed if you set "replyMode": "ai" in config.json.
# Get a key at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Set to "debug" if you need to see Baileys' internal WhatsApp protocol chatter.
BAILEYS_LOG_LEVEL=silent

# Phone voicemail (npm run phone) - from console.twilio.com
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
